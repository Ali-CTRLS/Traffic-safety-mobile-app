@startuml EmergencyServices_Activity

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #BA7517
  FontSize 12
  FontName Arial
}
skinparam activityDiamond {
  BackgroundColor #FFFFFF
  BorderColor #BA7517
}
skinparam activityStart {
  Color #222222
}
skinparam activityEnd {
  Color #222222
}
skinparam arrow {
  Color #333333
}

title Activity Diagram – Emergency Services

|Emergency Services|

start

:Open mobile app;

:Enter email and password;

if (Login valid?) then (Yes)
  :Standby on dashboard;
else (No)
  :Show error message;
  :Re-enter credentials;
  -> Enter email and password;
endif

:Receive dispatch alert\n(location · incident type);

:Acknowledge dispatch;

:Navigate to incident;

if (Road blocked?) then (Yes)
  :Request road clearance;
  :Resume navigation;
else (No)
  :Continue navigation;
endif

:Arrive on scene;

:Update incident status\n(In Progress → Resolved);

stop

@enduml
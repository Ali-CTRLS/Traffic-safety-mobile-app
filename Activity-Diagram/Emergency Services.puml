@startuml EmergencyServices_Activity

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #BA7517
  FontSize 12
  FontName Arial
}

title Emergency Services Activity

|Emergency Services|

start

:Open mobile app;

repeat
  :Enter email and password;

  if (Login valid?) then (Yes)
    break
  else (No)
    :Show error message;
  endif

repeat while (Invalid login)

:Standby on dashboard;

:Receive dispatch alert;

:Acknowledge dispatch;

:Navigate to incident;

if (Road blocked?) then (Yes)
  :Request clearance;
endif

:Arrive on scene;

:Update status (Resolved);

stop
@enduml
@startuml Administrator_Activity

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #6441A5
  FontSize 12
  FontName Arial
}

title Activity Diagram – Administrator

|Administrator|

start

:Open mobile app;

repeat
  :Enter email and password;

  if (Login valid?) then (Yes)
    break
  else (No)
    :Show error message;
  endif

repeat while (Invalid login)

:View admin dashboard;

if (Choose task?) then (Manage Users)
  :Add / Edit / Deactivate users;

elseif (Configure Alerts)
  :Set alert rules\n(thresholds · zones · types);

elseif (View Analytics)
  :View analytics dashboard\n(incidents · violations · trends);

else (Generate Reports)
  :Generate safety report;
  :Export as PDF;

endif

:Logout;

stop
@enduml